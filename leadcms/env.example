# Template for leadcms/.env. Run ./setup.sh to generate .env with random secrets.
# .env is gitignored; never commit it.

# Image tag (only pre-release tags are published upstream)
LEADCMS_VERSION=1.5.155-pre

# JWT
JWT__SECRET=__GENERATED__
JWT__ISSUER=ec-map-leadcms
JWT__AUDIENCE=ec-map-leadcms

# Default admin user (password must include upper, lower, digit, symbol)
DEFAULTUSERS__0__USERNAME=admin
DEFAULTUSERS__0__EMAIL=admin@ecmap.local
DEFAULTUSERS__0__PASSWORD=__GENERATED__
DEFAULTUSERS__0__ROLES__0=Admin

# PostgreSQL (dedicated instance; "postgres" is the in-network hostname)
POSTGRES__SERVER=postgres
POSTGRES__PORT=5432
POSTGRES__USERNAME=leadcms
POSTGRES__PASSWORD=__GENERATED__
POSTGRES__DATABASE=leadcms

# Email: local Mailpit catcher. Swap for real SMTP before sending anything external.
EMAIL__SERVER=mailpit
EMAIL__PORT=1025
EMAIL__USESSL=false
EMAIL__USERNAME=leadcms
EMAIL__PASSWORD=leadcms

# CORS: EC-Map dev (4000), Docker preview (3000), LeadCMS itself (8080)
CORS__ALLOWEDORIGINS__0=http://localhost:8080
CORS__ALLOWEDORIGINS__1=http://localhost:3000
CORS__ALLOWEDORIGINS__2=http://localhost:4000

ENTITIES__INCLUDE__0=Contact
ENTITIES__INCLUDE__1=Content
ENTITIES__INCLUDE__2=ContentType
ENTITIES__INCLUDE__3=EmailTemplate
ENTITIES__INCLUDE__4=Link
ENTITIES__INCLUDE__5=Media
ENTITIES__INCLUDE__6=User
ENTITIES__INCLUDE__7=Setting
ENTITIES__INCLUDE__8=Redirect

SUPPORTEDLANGUAGES__0=en
