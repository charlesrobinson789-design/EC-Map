{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	handle /api/intake {
		reverse_proxy intake:8000
	}
	handle {
		root * /srv/site
		file_server
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# n8n automations. Sign-in is n8n's own: the owner account is created from the server's secrets
# before n8n first starts (no open setup page), and Charles turns on two-step login.
# No password prompt at the edge: Claude's n8n connector signs in with OAuth and calls
# /mcp-server and /mcp-oauth from Anthropic's servers, which a browser-style prompt would block.
# No `encode` here: it would buffer n8n's streamed MCP responses.
automations.{$SITE_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	# Public n8n forms are not used. Keep them off the internet.
	@forms path /form/* /form-test/* /form-waiting/*
	respond @forms 404
	reverse_proxy n8n:5678
}

#ASSESS_BLOCK#
