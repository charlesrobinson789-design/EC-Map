# Template for crm/.env. Run ./setup.sh to generate .env with random secrets.
# .env is gitignored; never commit it. One .env per business instance.

# Instance identity (also the Docker Compose project name)
INSTANCE_NAME=crm
TIMEZONE=America/New_York

# Production only (docker-compose.prod.yml): public hostnames, DNS A records -> server IP
CRM_DOMAIN=crm.example.com
AUTOMATION_DOMAIN=automations.example.com
ACME_EMAIL=you@example.com
# Marketing site that hosts signup forms (CORS + links in emails)
SITE_URL=https://example.com
SITE_URL_WWW=https://www.example.com

# Image tag (only pre-release tags are published upstream)
LEADCMS_VERSION=1.5.155-pre

# Postgres superuser (used only to create per-app databases on first start)
POSTGRES_ADMIN_PASSWORD=__GENERATED__

# LeadCMS
JWT__SECRET=__GENERATED__
JWT__ISSUER=crm
JWT__AUDIENCE=crm

DEFAULTUSERS__0__USERNAME=admin
DEFAULTUSERS__0__EMAIL=admin@crm.local
DEFAULTUSERS__0__PASSWORD=__GENERATED__
DEFAULTUSERS__0__ROLES__0=Admin

POSTGRES__SERVER=postgres
POSTGRES__PORT=5432
POSTGRES__USERNAME=leadcms
POSTGRES__PASSWORD=__GENERATED__
POSTGRES__DATABASE=leadcms

# Email: local Mailpit catcher. Replace with real SMTP (e.g. Hostinger mailbox, SendGrid) for production.
EMAIL__SERVER=mailpit
EMAIL__PORT=1025
EMAIL__USESSL=false
EMAIL__USERNAME=crm
EMAIL__PASSWORD=crm

CORS__ALLOWEDORIGINS__0=http://localhost:8080
CORS__ALLOWEDORIGINS__1=http://localhost:3000
CORS__ALLOWEDORIGINS__2=http://localhost:4000

SUPPORTEDLANGUAGES__0=en

# Site plugin: public /api/subscribe (double opt-in), /api/unsubscribe, /api/contact-us
PLUGINS__0=LeadCMS.Plugin.Site
SUBSCRIPTION_TOKEN_SECRET=__GENERATED__
CONTACTUS__TO__0=admin@crm.local
SUPPORTEMAIL=admin@crm.local
# Local defaults; docker-compose.prod.yml overrides these from CRM_DOMAIN / SITE_URL.
SITEURL=http://localhost:8080
CONFIRMATIONURLTEMPLATE=http://localhost:8080/confirm-subscription?token={token}
GENERAL__UNSUBSCRIBEURL=http://localhost:8080/unsubscribe

# n8n
N8N_DB_PASSWORD=__GENERATED__
N8N_ENCRYPTION_KEY=__GENERATED__
